{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "P2P Screen Sharing",
  "version": "0.1.0",
  "identifier": "com.rust.p2pscreensharing",
  "build": {
    "frontendDist": "../client-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "P2P Screen Sharing (100% Rust)",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
